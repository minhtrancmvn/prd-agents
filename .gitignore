# Ignore every Claude Code runtime and configuration file by default.
/*

# Version only global PRD agent source files and their shared standards.
!/.gitignore
!/agents/
/agents/*
!/agents/prd-*.md
!/prd-shared-authoring-standards.md
!/README.md

# Version approved PRD pipeline source and design specifications.
!/docs/
/docs/*
!/docs/superpowers/
/docs/superpowers/*
!/docs/superpowers/specs/
/docs/superpowers/specs/*
!/docs/superpowers/specs/2026-09-24-prd-pipeline-design.md
!/docs/superpowers/plans/
/docs/superpowers/plans/*
!/docs/superpowers/plans/2026-09-24-prd-pipeline.md
!/skills/
/skills/*
!/skills/prd-pipeline/
!/skills/prd-pipeline/**
# Never track generated bytecode or caches inside the pipeline package.
__pycache__/
*.py[cod]
